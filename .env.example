GRID_TOKEN=change-me-to-a-long-random-string
GRID_DOMAIN=grid.example.com

# Data stack (docker compose --profile data up -d)
GCP_PROJECT=my-gcp-project
BQ_RAW_DATASET=grid_raw
BQ_DATASET=grid_analytics
BQ_LOCATION=EU
# Put the service account key at secrets/gcp-key.json (BigQuery Data Editor + Job User)

# Airflow login (created/updated at each start; leave empty to use the
# generated 'admin' password in /opt/airflow/standalone_admin_password.txt)
AIRFLOW_ADMIN_USER=nico
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=
